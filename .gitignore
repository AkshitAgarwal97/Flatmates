# app data on disk (listings, photos)
/data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/data/db.json
/public/uploads/*

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
