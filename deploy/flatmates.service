[Unit]
Description=Flatmates.co.in Next.js
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/flatmates
EnvironmentFile=/etc/flatmates.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node /opt/flatmates/server.js
Restart=always
RestartSec=3
WatchdogSec=0
LimitNOFILE=65535
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
